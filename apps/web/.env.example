# Docker PostGIS (apps/web: docker compose up -d postgres) — matches production Postgres + PostGIS
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/mbqb
PAYLOAD_SECRET=YOUR_SECRET_HERE
BLOB_READ_WRITE_TOKEN=

# Public site URL (no trailing slash). Used for Payload admin links and live preview.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Shared secret for /preview draft-mode handoff (must match in Vercel env for production).
PREVIEW_SECRET=YOUR_PREVIEW_SECRET_HERE

# Optional: pull production vars into repo root, then run `pnpm seed:dev-from-prod`
# DOTENV_CONFIG_PATH=../../.vercel/.env.production.local
