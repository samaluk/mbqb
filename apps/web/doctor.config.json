{
  "$schema": "https://react.doctor/schema/config.json",
  // Strict gate: any diagnostic (error or warning) fails the run, which is
  // equivalent to breaking under a health score of 100.
  "blocking": "warning",
  "ignore": {
    "overrides": [
      {
        // Payload registers migrations by scanning the migrationDir named in
        // payload.config.ts ("src/migrations") and importing it at runtime,
        // so the static import graph cannot see these files as reachable.
        // payload-generated-schema.ts is regenerated by `payload
        // generate:db-schema` and consumed by Payload's migration diffing
        // tooling. Both are runtime/tooling entry points, not dead code —
        // unused-file's own contract says to reject matches loaded through
        // mechanisms the graph cannot resolve.
        "files": ["src/migrations/**", "src/payload-generated-schema.ts"],
        "rules": ["deslop/unused-file"]
      },
      {
        // React Compiler automatically memoizes context values; manual
        // memoization triggers react-compiler-no-manual-memoization in full/changed scans.
        "files": ["**/PlacesGeoContext.tsx"],
        "rules": ["react-doctor/context-provider-value-from-unmemoized-local-literal"]
      }
    ]
  }
}
