{
  "name": "@mbqb/web",
  "version": "1.0.0",
  "description": "A blank template to get started with Payload 3.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm run migrate && pnpm run build:next",
    "build:next": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "env:pull": "vercel env pull .env.local",
    "env:pull:production": "vercel env pull .env.production.local --environment=production",
    "create:prod-user": "cross-env NODE_ENV=production NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" tsx scripts/create-payload-user.ts",
    "seed:dev-from-prod": "bash scripts/seed-dev-from-production.sh",
    "ci": "pnpm run build",
    "migrate": "cross-env NODE_ENV=production NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" tsx scripts/run-payload-migrate.ts",
    "migrate:test": "cross-env NODE_ENV=production NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" tsx scripts/run-payload-migrate-test.ts",
    "migrate:baseline": "node scripts/build-baseline-migration.mjs",
    "migrate:create": "pnpm payload migrate:create",
    "migrate:down": "pnpm payload migrate:down",
    "migrate:fresh": "pnpm payload migrate:fresh",
    "migrate:status": "pnpm payload migrate:status",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "pnpm run test:unit",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "pnpm migrate:test && cross-env INTEGRATION_TEST=true NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts --fileParallelism=false tests/int",
    "test:unit": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts tests/unit",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.85.0",
    "@payloadcms/live-preview-react": "3.85.0",
    "@payloadcms/next": "3.85.0",
    "@payloadcms/richtext-lexical": "3.85.0",
    "@payloadcms/storage-vercel-blob": "3.85.0",
    "@payloadcms/ui": "3.85.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^10.0.0",
    "dotenv": "17.4.2",
    "graphql": "^16.14.0",
    "isomorphic-dompurify": "^3.15.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.17.0",
    "next": "16.2.7",
    "payload": "3.85.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-leaflet": "^5.0.0",
    "shadcn": "^4.9.0",
    "sharp": "0.34.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/react": "16.3.2",
    "@types/leaflet": "^1.9.21",
    "@types/node": "24.12.4",
    "@types/react": "19.2.16",
    "@types/react-dom": "19.2.3",
    "@typescript/native-preview": "7.0.0-dev.20260604.1",
    "@vitejs/plugin-react": "5.2.0",
    "jsdom": "29.1.1",
    "tailwindcss": "^4.3.0",
    "tsx": "4.22.4",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
