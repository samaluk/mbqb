{
  "name": "mbqb",
  "private": true,
  "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1",
  "engines": {
    "node": "24.19.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.19.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "build": "pnpm --filter @mbqb/web build",
    "build:production": "pnpm --filter @mbqb/web build:production",
    "dev": "pnpm --filter @mbqb/web dev",
    "fallow": "fallow",
    "fallow:config": "fallow config",
    "fallow:status": "fallow type-aware status",
    "fallow:dead-code": "fallow dead-code --type-aware",
    "fallow:dupes": "fallow dupes",
    "fallow:health": "fallow health --coverage coverage/coverage-final.json --coverage-root \"$PWD\"",
    "fallow:audit": "fallow audit --gate new-only --type-aware --coverage coverage/coverage-final.json --coverage-root \"$PWD\"",
    "fallow:ci": "pnpm fallow:audit",
    "fallow:recommend": "fallow recommend",
    "fallow:security": "fallow security",
    "fallow:suppressions": "fallow suppressions",
    "fallow:boundaries": "fallow list --boundaries",
    "fallow:fix:preview": "fallow fix --type-aware --dry-run",
    "fallow:fix": "fallow fix --type-aware",
    "generate:types": "pnpm --filter @mbqb/web generate:types",
    "format": "oxfmt --write apps/web",
    "format:check": "oxfmt --check apps/web",
    "check:lint": "oxlint apps/web --ignore-path .oxlintignore && oxlint apps/web --config .oxlintrc.tailwind.json --ignore-path .oxlintignore",
    "oxlint": "pnpm check:lint",
    "lint:core": "oxlint apps/web --ignore-path .oxlintignore",
    "lint:fix": "oxlint --fix apps/web --ignore-path .oxlintignore && oxlint --fix apps/web --config .oxlintrc.tailwind.json --ignore-path .oxlintignore",
    "lint:fix:core": "oxlint --fix apps/web --ignore-path .oxlintignore",
    "lint:fix:tailwind": "oxlint --fix apps/web --config .oxlintrc.tailwind.json --ignore-path .oxlintignore",
    "lint:tailwind": "oxlint apps/web --config .oxlintrc.tailwind.json --ignore-path .oxlintignore",
    "migrate": "pnpm --filter @mbqb/web migrate",
    "migrate:production": "pnpm --filter @mbqb/web migrate:production",
    "test": "pnpm --filter @mbqb/web test",
    "test:coverage": "pnpm --filter @mbqb/web test:coverage",
    "test:e2e": "pnpm --filter @mbqb/web test:e2e",
    "test:int": "pnpm --filter @mbqb/web test:int",
    "test:unit": "pnpm --filter @mbqb/web test:unit",
    "typecheck": "pnpm --filter @mbqb/web typecheck"
  },
  "devDependencies": {
    "fallow": "3.17.0",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "oxlint-tailwindcss": "1.9.0",
    "oxlint-tsgolint": "7.0.2001"
  }
}
