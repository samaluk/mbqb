{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": [
    "apps/web/src/app/**/{page,layout,loading,error,not-found,route,default,template}.{ts,tsx}",
    "apps/web/src/payload.config.ts",
    "apps/web/scripts/seed-e2e-fixtures.ts"
  ],
  "ignorePatterns": [
    "**/.next/**",
    "**/payload-types.ts",
    "**/payload-generated-schema.ts",
    "apps/web/tests/e2e/**",
    "apps/web/playwright-report/**",
    "apps/web/test-results/**",
    "scripts/**"
  ],
  "ignoreFindings": [
    "apps/web/src/migrations/**"
  ],
  "ignoreExports": [
    {
      "file": "apps/web/src/components/ui/*.tsx",
      "exports": [
        "*"
      ]
    }
  ],
  "ignoreDependencies": [
    "@base-ui/react",
    "class-variance-authority",
    "@next/playwright",
    "shadcn",
    "tw-animate-css",
    "tailwindcss"
  ],
  "typeAware": {
    "enabled": true,
    "require": "complete",
    "projects": [
      "apps/web/tsconfig.json",
      "apps/web/tsconfig.tests.json"
    ]
  },
  "rules": {
    "unused-files": "error",
    "unused-exports": "error",
    "unused-types": "error",
    "private-type-leaks": "error",
    "unused-dependencies": "error",
    "unused-dev-dependencies": "error",
    "unused-optional-dependencies": "warn",
    "unused-enum-members": "error",
    "unused-class-members": "error",
    "unused-store-members": "warn",
    "unprovided-injects": "warn",
    "unrendered-components": "warn",
    "unused-component-props": "warn",
    "unused-component-emits": "warn",
    "unused-component-inputs": "warn",
    "unused-component-outputs": "warn",
    "unused-svelte-events": "warn",
    "unused-server-actions": "error",
    "unused-load-data-keys": "warn",
    "prop-drilling": "off",
    "thin-wrapper": "off",
    "duplicate-prop-shape": "off",
    "css-token-drift": "error",
    "css-duplicate-block": "error",
    "css-selector-complexity": "error",
    "css-dead-surface": "error",
    "css-broken-reference": "error",
    "unresolved-imports": "error",
    "unlisted-dependencies": "error",
    "duplicate-exports": "error",
    "type-only-dependencies": "error",
    "test-only-dependencies": "error",
    "dev-dependencies-in-production": "error",
    "circular-dependencies": "error",
    "re-export-cycle": "error",
    "boundary-violation": "error",
    "coverage-gaps": "off",
    "feature-flags": "off",
    "stale-suppressions": "error",
    "require-suppression-reason": "error",
    "unused-catalog-entries": "error",
    "empty-catalog-groups": "error",
    "unresolved-catalog-references": "error",
    "unused-dependency-overrides": "error",
    "misconfigured-dependency-overrides": "error",
    "security-client-server-leak": "off",
    "security-sink": "off",
    "policy-violation": "warn",
    "invalid-client-export": "error",
    "mixed-client-server-barrel": "error",
    "misplaced-directive": "error",
    "route-collision": "error",
    "dynamic-segment-name-conflict": "error"
  },
  "duplicates": {
    "mode": "semantic",
    "near": true,
    "minLines": 8,
    "minTokens": 60,
    "minOccurrences": 3,
    "ignoreImports": true
  },
  "health": {
    "maxCyclomatic": 20,
    "maxCognitive": 15,
    "maxCrap": 30,
    "maxUnitSize": 60
  },
  "audit": {
    "gate": "new-only",
    "typeAware": true,
    "deadCodeBaseline": "fallow-baselines/audit-dead-code.json",
    "healthBaseline": "fallow-baselines/health.json",
    "dupesBaseline": "fallow-baselines/dupes.json"
  },
  "workspaces": {
    "packages": [
      "apps/*"
    ]
  },
  "boundaries": {
    "zones": [
      {
        "name": "data",
        "patterns": [
          "apps/web/src/collections/**",
          "apps/web/src/globals/**",
          "apps/web/src/access/**",
          "apps/web/src/payload.config.ts"
        ]
      },
      {
        "name": "domain",
        "patterns": [
          "apps/web/src/lib/**"
        ]
      },
      {
        "name": "ui",
        "patterns": [
          "apps/web/src/components/**"
        ]
      },
      {
        "name": "app",
        "patterns": [
          "apps/web/src/app/**"
        ]
      }
    ],
    "rules": [
      {
        "from": "ui",
        "allow": [
          "ui",
          "domain"
        ]
      },
      {
        "from": "domain",
        "allow": [
          "domain",
          "data"
        ]
      },
      {
        "from": "data",
        "allow": [
          "data",
          "domain"
        ]
      }
    ]
  }
}
