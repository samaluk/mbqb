{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": [
    "apps/web/src/app/**/{page,layout,loading,error,not-found,route,default,template}.{ts,tsx}",
    "apps/web/src/payload.config.ts",
    "apps/web/scripts/seed-e2e-fixtures.ts"
  ],
  "ignorePatterns": [
    "**/.next/**",
    "**/payload-types.ts",
    "**/payload-generated-schema.ts",
    "apps/web/tests/e2e/**",
    "apps/web/playwright-report/**",
    "apps/web/test-results/**",
    "scripts/**"
  ],
  "ignoreFindings": [
    "apps/web/src/migrations/**"
  ],
  "ignoreExports": [
    {
      "file": "apps/web/src/components/ui/*.tsx",
      "exports": [
        "*"
      ]
    }
  ],
  "ignoreDependencies": [
    "@base-ui/react",
    "class-variance-authority",
    "@next/playwright",
    "shadcn",
    "tw-animate-css",
    "tailwindcss"
  ],
  "typeAware": {
    "enabled": true,
    "require": "complete",
    "projects": [
      "apps/web/tsconfig.json",
      "apps/web/tsconfig.tests.json"
    ]
  },
  "rules": {
    "private-type-leaks": "warn"
  },
  "duplicates": {
    "mode": "semantic",
    "near": true,
    "minLines": 8,
    "minTokens": 60,
    "minOccurrences": 3,
    "ignoreImports": true
  },
  "health": {
    "maxCyclomatic": 20,
    "maxCognitive": 15,
    "maxCrap": 30,
    "maxUnitSize": 60
  },
  "audit": {
    "gate": "new-only",
    "deadCodeBaseline": "fallow-baselines/dead-code.json",
    "healthBaseline": "fallow-baselines/health.json",
    "dupesBaseline": "fallow-baselines/dupes.json"
  },
  "workspaces": {
    "packages": [
      "apps/*"
    ]
  }
}
