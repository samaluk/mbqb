{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": [
    "apps/web/src/app/**/{page,layout,loading,error,not-found,route,default,template}.{ts,tsx}",
    "apps/web/src/payload.config.ts"
  ],
  "ignorePatterns": [
    "**/.next/**",
    "**/payload-types.ts",
    "**/payload-generated-schema.ts",
    "apps/web/tests/e2e/**",
    "apps/web/playwright-report/**",
    "apps/web/test-results/**",
    "scripts/**"
  ],
  "ignoreFindings": [
    "apps/web/src/migrations/**"
  ],
  "ignoreExports": [
    {
      "file": "apps/web/src/components/ui/*.tsx",
      "exports": [
        "*"
      ]
    }
  ],
  "ignoreDependencies": [
    "@base-ui/react",
    "class-variance-authority",
    "shadcn",
    "tw-animate-css",
    "tailwindcss"
  ],
  "typeAware": {
    "enabled": true,
    "require": "complete",
    "projects": [
      "apps/web/tsconfig.json",
      "apps/web/tsconfig.tests.json"
    ]
  },
  "rules": {
    "private-type-leaks": "warn"
  },
  "duplicates": {
    "mode": "semantic",
    "minLines": 8,
    "minTokens": 60,
    "minOccurrences": 3,
    "ignoreImports": true
  },
  "health": {
    "maxCyclomatic": 20,
    "maxCognitive": 15,
    "maxCrap": 30,
    "maxUnitSize": 60
  },
  "audit": {
    "gate": "new-only",
    "deadCodeBaseline": "fallow-baselines/dead-code.json",
    "healthBaseline": "fallow-baselines/health.json",
    "dupesBaseline": "fallow-baselines/dupes.json"
  },
  "workspaces": {
    "packages": [
      "apps/*"
    ]
  },
  "regression": {
    "baseline": {
      "analysisIdentity": {
        "mode": "type-aware",
        "semantic_schema_version": 2,
        "capabilities": [
          "symbol-use",
          "api-surface"
        ],
        "project_config_hash": "sha256:766d07edf00b4474ed898cfc8291fb7f6ea6662930c2393574ad4493a00d8de2",
        "backend_family": "typescript-go",
        "completeness": "complete"
      },
      "totalIssues": 20,
      "unusedFiles": 3,
      "unusedExports": 6,
      "unusedTypes": 2,
      "unusedDependencies": 2,
      "unusedDevDependencies": 0,
      "unusedOptionalDependencies": 0,
      "unusedEnumMembers": 0,
      "unusedClassMembers": 0,
      "unresolvedImports": 0,
      "unlistedDependencies": 0,
      "duplicateExports": 0,
      "circularDependencies": 0,
      "reExportCycles": 0,
      "typeOnlyDependencies": 0,
      "testOnlyDependencies": 0,
      "devDependenciesInProduction": 0,
      "boundaryViolations": 0,
      "boundaryCoverageViolations": 0,
      "boundaryCallViolations": 0,
      "policyViolations": 0
    }
  }
}
